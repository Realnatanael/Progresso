PORT=4000
NODE_ENV=development

# Local (Docker): mongodb://127.0.0.1:27017/progresso
# Atlas: mongodb+srv://USER:PASS@CLUSTER.mongodb.net/progresso?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/progresso

JWT_SECRET=troque-por-um-segredo-longo
CLIENT_ORIGIN=http://localhost:5173

# Google AI Studio — geração do personagem ninja (page Ninja)
GEMINI_API_KEY=
# Opcional; padrão: gemini-2.5-flash-image
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Texto: modo história + missão diária (padrão: gemini-3.8-flash)
GEMINI_TEXT_MODEL=gemini-3.8-flash
